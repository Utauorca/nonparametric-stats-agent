# 要用哪一家 LLM：gemini 或 claude
LLM_PROVIDER=gemini

# ===== Gemini（LLM_PROVIDER=gemini 時使用）=====
# 金鑰申請：https://aistudio.google.com/apikey （有免費額度）
GEMINI_API_KEY=你的_gemini_api_key
# 免費層可用：gemini-3.8-flash / gemini-3.5-flash / gemini-3.6-flash / gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# ===== Claude（LLM_PROVIDER=claude 時使用；沒有可留空）=====
# 金鑰申請：https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-你的_claude_api_key
ANTHROPIC_MODEL=claude-opus-4-8

# ===== R（run_r 工具使用；選填）=====
# 留空：自動從 PATH 或 C:\Program Files\R\ 底下找最新版的 Rscript
# 要固定某個 R 版本時填完整路徑，例如：C:\Program Files\R\R-4.5.3\bin\Rscript.exe
RSCRIPT_PATH=
